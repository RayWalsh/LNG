# Copy to .env ONLY if running fetch_panama_wait_times.py manually on your
# own machine for debugging. Never commit a real .env file.
#
# In normal operation this repo does NOT use a local .env at all — the real
# key lives as a GitHub Actions repository secret named VORTEXA_API_KEY
# (Settings -> Secrets and variables -> Actions), and only the Action ever
# uses it.

VORTEXA_API_KEY=your-key-here
